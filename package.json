{
  "name": "archinstall",
  "version": "2.0.1",
  "description": "automate your installation process",
  "keywords": [
    "archLinux",
    "arch",
    "linux",
    "install",
    "automatism",
    "automatic"
  ],
  "homepage": "https://tsickert.com/archinstall",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/archinstall.git"
  },
  "main": "archinstall.sh",
  "bin": {
    "arch-install": "archinstall.sh",
    "pack-into-archiso": "pack-into-archiso.sh"
  },
  "files": [
    "archinstall.sh",
    "pack-into-archiso.sh"
  ],
  "scripts": {
    "build": "echo nothing to build.",
    "clear": "[ ! -e apiDocumentation ] || rm --recursive apiDocumentation",
    "document": "mkdir --parents apiDocumentation/archinstall/latest && yarn document:show 1>apiDocumentation/archinstall/latest/index.html",
    "document:show": "bash ./node_modules/.bin/bashlink-document ../../archinstall",
    "document:show:error": "bash ./node_modules/.bin/bashlink-document archinstall 1>/dev/null",
    "lint": "shellcheck -x *.sh",
    "lint:given": "shellcheck -x",
    "test": "bash ./node_modules/.bin/bashlink-doctest --verbose ./archinstall && bash ./node_modules/.bin/bashlink-doctest --verbose ./pack-into-archiso",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "bashlink": "2.0.1"
  },
  "devDependencies": {
    "shellcheck": "^4.1.0",
    "web-documentation": "^1.0.77"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "automate your installation process<!--deDE:Automatisiere deinen Installationsprozess-->"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
